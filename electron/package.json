{
  "name": "salesbuddy-desktop",
  "productName": "Sales Buddy",
  "description": "Desktop shell for Sales Buddy - an Electron window + tray over the same git-pulled Flask app. The Electron main process launches the Python supervisor (web + worker) and loads the local web UI.",
  "main": "main.js",
  "version": "1.1.4",
  "license": "MIT",
  "author": {
    "name": "Sales Buddy"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.7",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.salesbuddy.desktop",
    "productName": "Sales Buddy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell-theme.js",
      "shell-menu.js",
      "input-focus.js",
      "input-focus.ps1",
      "window-state.js",
      "status-screen.js",
      "status.html",
      "status.css",
      "status.js",
      "theme-tokens.css",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": ["input-focus.ps1"],
    "win": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "../static/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
